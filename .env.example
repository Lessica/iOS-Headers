# Stack identity
COMPOSE_PROJECT_NAME=ios_headers

# ClickHouse
CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_NATIVE_PORT=19000
CLICKHOUSE_DB=ios_headers
CLICKHOUSE_USER=iosh
CLICKHOUSE_PASSWORD=ioshpass

# Redis
REDIS_PORT=16379
REDIS_APPENDONLY=no
REDIS_MAXMEMORY=512mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=19001
MINIO_CONSOLE_PORT=19002
MINIO_BUCKET=ios-headers

# Web
WEB_PORT=18080
CDN_ORIGIN_VERIFY_SECRET=C84902B7-EDE8-42C7-8A9A-8B853C4472DB
VIEW_CACHE_TTL=2592000
SEARCH_CACHE_TTL=300
SEARCH_QUERY_CACHE_MAX_TTL=60
VERSION_CACHE_TTL=86400
STATS_CACHE_TTL=600
ENABLE_REDIS_PAGE_CACHE=false
SHOW_QUERY_ELAPSED_MS=false
ENABLE_CH_QUERY_DEBUG=false
ENABLE_CH_QUERY_EXPLAIN=false
CH_QUERY_DEBUG_MATCH=
CH_QUERY_EXPLAIN_ONCE=true
CH_QUERY_SLOW_MS=200
CH_QUERY_PREVIEW_CHARS=400

# FRP tunnel client (optional, enabled by profile: tunnel)
FRP_SERVER_ADDR=
FRP_SERVER_PORT=7000
FRP_TOKEN=replace-with-long-random-token
FRP_PROXY_NAME=ios-headers-web
FRP_REMOTE_PORT=18080

# Local bind mounts
STACK_DATA_DIR=./data
